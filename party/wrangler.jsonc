{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cambio",
  "main": "src/server.ts",
  "compatibility_date": "2026-05-03",
  "durable_objects": {
    "bindings": [{ "name": "Cambio", "class_name": "Cambio" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Cambio"] }],
  "assets": {
    "directory": "../client/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/parties/*"]
  },
  "dev": { "port": 1999 }
}
